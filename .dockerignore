# Only source goes into the build; dependencies and output are made inside it
**/node_modules
**/dist
**/*.tsbuildinfo
**/.env
**/.env.*
!**/.env.example
.git
.claude
.vscode
# Not part of the build; leaving them out keeps doc edits from busting the build cache
.github
docs
**/*.md
# The browser test runs against the image, not in it
e2e
test-results
playwright-report
