{
  "name": "@taskhold/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/rpc-client.ts",
    "./chore-schedule": "./src/features/chores/chore-schedule.ts",
    "./invite-code": "./src/features/households/invite-code.ts",
    "./live-topics": "./src/features/live/live-topics.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "NODE_ENV=production node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc",
    "auth:generate": "auth generate --config src/features/auth/auth.ts --output src/features/auth/auth.table.ts --yes && node scripts/strip-auth-relations.mjs src/features/auth/auth.table.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run --passWithNoTests",
    "test:ci": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.27",
    "@hono/node-server": "^2.1.11",
    "@hono/zod-validator": "^0.9.1",
    "better-auth": "^1.7.27",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "^4.13.19",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "web-push": "4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@better-auth/core": "1.7.27",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/web-push": "3.6.4",
    "auth": "^1.7.27",
    "drizzle-kit": "1.0.0-rc.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  }
}
