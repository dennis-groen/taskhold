PORT=3000
DATABASE_URL=postgres://taskhold:taskhold@localhost:5432/taskhold

# Generate with: pnpm --filter @taskhold/api exec auth secret
BETTER_AUTH_SECRET=
# Public origin the browser uses. In dev that's the Vite server, which proxies /api.
BETTER_AUTH_URL=http://localhost:5173

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Reverse proxies in front of the API (IPs or CIDR ranges, comma-separated). Leave empty when
# clients connect to the API directly. Used to find the real client IP for rate limiting.
TRUSTED_PROXIES=
