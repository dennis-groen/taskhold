PORT=3000
DATABASE_URL=postgres://taskhold:taskhold@localhost:5432/taskhold

# Generate with: pnpm --filter @taskhold/api exec auth secret
BETTER_AUTH_SECRET=
# Public origin the browser uses. In dev that's the Vite server, which proxies /api.
BETTER_AUTH_URL=http://localhost:5173

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Reverse proxies in front of the API (IPs or CIDR ranges, comma-separated). Leave empty when
# clients connect to the API directly. Used to find the real client IP for rate limiting.
TRUSTED_PROXIES=

# Chore reminders (Web Push). Generate a pair with:
#   pnpm --filter @taskhold/api exec web-push generate-vapid-keys
# Leave empty to switch reminders off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, a mailto: or https: URL. Defaults to BETTER_AUTH_URL when that's https.
# VAPID_SUBJECT=mailto:you@example.com

# "true" offers a demo on the sign-in page: each visitor gets a seeded household of their own,
# deleted after a day. Off by default.
# DEMO_MODE=true

# Folder with the web app's build to serve next to the API. Set in the Docker image; leave unset in
# development, where Vite serves the web app.
# WEB_ROOT=../web/dist

# Logging. Every request writes one wide event (see docs/operations.md, "Logging").
# LOG_LEVEL: fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info
# LOG_FORMAT: json for log collectors, pretty for a terminal (defaults to pretty in development)
# LOG_FORMAT=json
# Share of successful, fast requests to keep (0 to 1). Errors and slow requests are always kept.
LOG_SAMPLE_RATE=1
