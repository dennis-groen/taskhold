{
  "name": "taskhold",
  "private": true,
  "description": "Phone-first PWA for shared households: shopping lists, chores with reminders, private to-dos",
  "homepage": "https://taskhold.lunexa.dev",
  "bugs": "https://github.com/dennis-groen/taskhold/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dennis-groen/taskhold.git"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --recursive run dev",
    "dev:api": "pnpm --filter @taskhold/api dev",
    "dev:web": "pnpm --filter @taskhold/web dev",
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck && tsc -p e2e",
    "test": "pnpm --recursive run test",
    "test:api": "pnpm --filter @taskhold/api test",
    "test:web": "pnpm --filter @taskhold/web test",
    "test:invariants": "vitest run --config vitest.config.ts",
    "test:ci": "pnpm test:invariants && pnpm --recursive run test:ci",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "knip": "knip",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm format:check && pnpm lint --deny-warnings && pnpm typecheck && pnpm test:invariants && pnpm knip",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @taskhold/api db:generate",
    "db:migrate": "pnpm --filter @taskhold/api db:migrate",
    "db:studio": "pnpm --filter @taskhold/api db:studio",
    "auth:generate": "pnpm --filter @taskhold/api auth:generate"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.6",
    "knip": "^6.48.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "typescript": "~7.0.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.3.4"
}
