{
  "name": "taskhold",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --recursive run dev",
    "dev:api": "pnpm --filter @taskhold/api dev",
    "dev:web": "pnpm --filter @taskhold/web dev",
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm format:check && pnpm lint --deny-warnings && pnpm typecheck"
  },
  "devDependencies": {
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4"
}
