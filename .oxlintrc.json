{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "es2024": true
  },
  "ignorePatterns": ["**/routeTree.gen.ts"],
  "rules": {
    // Named exports keep one name per thing across every import
    "import/no-default-export": "error"
  },
  "overrides": [
    {
      // Tool configs must export a default
      "files": ["**/*.config.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["apps/api/**"],
      "env": {
        "node": true
      }
    },

    // API layering: routes -> service -> repo. Only repo files query the database.
    {
      "files": ["apps/api/src/features/**/*.routes.ts", "apps/api/src/features/**/*.middleware.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(\\.repo|\\.table|/db/db)(\\.ts)?$",
                "message": "The HTTP layer calls services. Only repo files touch the database."
              },
              {
                "group": ["drizzle-orm", "drizzle-orm/*"],
                "message": "The HTTP layer calls services. Only repo files touch the database."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/api/src/features/**/*.service.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["drizzle-orm", "drizzle-orm/*"],
                "message": "Services hold business rules. Build queries in the feature's repo."
              },
              {
                "regex": "\\.table(\\.ts)?$",
                "allowTypeImports": true,
                "message": "Services hold business rules. Build queries in the feature's repo."
              },
              {
                "regex": "/db/db(\\.ts)?$",
                "importNames": ["db", "pool"],
                "message": "Services query through the repo. Use transaction() to group repo calls."
              },
              {
                "regex": "^\\.\\./[^/]+/[^/]+\\.repo(\\.ts)?$",
                "message": "Call the other feature's service, never its repo."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/api/src/features/**/*.repo.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "\\.(service|routes|middleware)(\\.ts)?$",
                "message": "The repo is the bottom layer. It can't call services or routes."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/api/src/lib/**", "apps/api/src/env.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "regex": "/features/", "message": "Shared code can't depend on a feature." }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/**"],
      "plugins": ["react", "jsx-a11y"],
      "env": {
        "browser": true
      },
      "rules": {
        // Side-effect imports: stylesheets, and polyfills that install themselves
        "import/no-unassigned-import": [
          "warn",
          { "allow": ["**/*.css", "temporal-polyfill/global"] }
        ],
        "react/react-in-jsx-scope": "off",
        "react/rules-of-hooks": "error",
        "react/only-export-components": ["warn", { "allowConstantExport": true }]
      }
    },

    // Icons come from one module, so the icon library can be swapped in one file.
    // Repeated in the layering overrides below, because a later override replaces the rule's options.
    {
      "files": ["apps/web/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@phosphor-icons/",
                "message": "Import icons from @/components/icons.ts, so the icon library can be swapped in one file."
              }
            ]
          }
        ]
      }
    },

    // Web layering: routes -> features -> shared (components, lib). Features never import each other.
    {
      "files": ["apps/web/src/components/**", "apps/web/src/lib/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/**", "@/routes/**"],
                "message": "Shared code can't depend on features or routes."
              },
              {
                "regex": "^@phosphor-icons/",
                "message": "Import icons from @/components/icons.ts, so the icon library can be swapped in one file."
              }
            ]
          }
        ]
      }
    },
    {
      // Files at a feature's root, e.g. features/households/households.api.ts
      "files": ["apps/web/src/features/*/*.ts", "apps/web/src/features/*/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/routes/**"],
                "message": "Features can't import routes. Read route data with getRouteApi()."
              },
              {
                "group": ["@/features/**"],
                "message": "Features don't import each other. Compose features in a route instead."
              },
              {
                "regex": "^\\.\\./",
                "message": "Relative imports stay inside the feature. Use @/components or @/lib for shared code."
              },
              {
                "regex": "^@phosphor-icons/",
                "message": "Import icons from @/components/icons.ts, so the icon library can be swapped in one file."
              }
            ]
          }
        ]
      }
    },
    {
      // Files one folder down, e.g. features/households/components/JoinHouseholdPage.tsx
      "files": ["apps/web/src/features/*/*/*.ts", "apps/web/src/features/*/*/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/routes/**"],
                "message": "Features can't import routes. Read route data with getRouteApi()."
              },
              {
                "group": ["@/features/**"],
                "message": "Features don't import each other. Compose features in a route instead."
              },
              {
                "regex": "^\\.\\./\\.\\./",
                "message": "Relative imports stay inside the feature. Use @/components or @/lib for shared code."
              },
              {
                "regex": "^@phosphor-icons/",
                "message": "Import icons from @/components/icons.ts, so the icon library can be swapped in one file."
              }
            ]
          }
        ]
      }
    },
    {
      // Keep features flat: at most one folder (components/) inside a feature
      "files": ["apps/web/src/features/*/*/*/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": ".*",
                "message": "Keep features flat: files at the root, components in components/. Or split the feature."
              }
            ]
          }
        ]
      }
    },
    {
      // TanStack route files export `Route`, shadcn components export variants
      "files": ["apps/web/src/routes/**", "apps/web/**/components/ui/**"],
      "plugins": ["react"],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      // shadcn components import icons directly (kept as shipped), and icons.ts is the one place that may
      "files": ["apps/web/src/components/ui/**", "apps/web/src/components/icons.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/**", "@/routes/**"],
                "message": "Shared code can't depend on features or routes."
              }
            ]
          }
        ]
      }
    },
    {
      // Generated by the shadcn CLI; keep them as shipped so updates stay diffable
      "files": ["apps/web/**/components/ui/**"],
      "plugins": ["jsx-a11y"],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off",
        "jsx-a11y/label-has-associated-control": "off"
      }
    }
  ]
}
