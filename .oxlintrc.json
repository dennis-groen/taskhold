{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "es2024": true
  },
  "ignorePatterns": ["**/routeTree.gen.ts"],
  "rules": {
    // Named exports keep one name per thing across every import
    "import/no-default-export": "error",
    // A cycle between modules breaks at load time, with a binding read before it's set
    "import/no-cycle": "error",
    // Both apps use the Temporal API for dates and times (see ARCHITECTURE.md)
    "no-restricted-globals": [
      "error",
      {
        "name": "Date",
        "message": "Use Temporal (see ARCHITECTURE.md, Dates and times) instead of Date. Use performance.now() for durations."
      }
    ],
    // Keep modules focused and readable in one pass; split large components or logic early
    "max-lines": [
      "error",
      {
        "max": 500,
        "skipBlankLines": true,
        "skipComments": true
      }
    ]
  },
  "overrides": [
    {
      // Tool configs must export a default
      "files": ["**/*.config.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      // Test suites can grow past the module cap without needing artificial file splits
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      "files": ["apps/api/**", "test/**"],
      "env": {
        "node": true
      }
    },
    {
      // Generated by Better Auth, which reads and writes Date columns itself
      "files": ["apps/api/src/features/auth/auth.table.ts"],
      "rules": {
        "no-restricted-globals": "off"
      }
    },

    // API layering: routes -> service -> repo. Only repo files query the database.
    // Baseline for all feature files (catches domain helpers, schedulers, errors, etc.).
    // Role-specific overrides below replace no-restricted-imports for their files.
    {
      "files": ["apps/api/src/features/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["drizzle-orm", "drizzle-orm/*"],
                "message": "Domain modules stay free of the database. Build queries in the feature's repo."
              },
              {
                "regex": "(\\.repo|/db/db)(\\.ts)?$",
                "message": "Domain modules stay free of the database. Call repo functions from a service."
              },
              {
                "regex": "\\.table(\\.ts)?$",
                "allowTypeImports": true,
                "message": "Domain modules stay free of tables at runtime. Use schemas or type imports."
              },
              {
                "regex": "\\.(routes|middleware)(\\.ts)?$",
                "message": "Domain modules can't depend on the HTTP layer."
              },
              {
                "regex": "^\\.\\./[^/]+/[^/]+\\.(repo|routes)(\\.ts)?$",
                "message": "Call the other feature's service, never its repo or routes."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/api/src/features/**/*.routes.ts", "apps/api/src/features/**/*.middleware.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(\\.repo|\\.table|/db/db)(\\.ts)?$",
                "message": "The HTTP layer calls services. Only repo files touch the database."
              },
              {
                "group": ["drizzle-orm", "drizzle-orm/*"],
                "message": "The HTTP layer calls services. Only repo files touch the database."
              },
              {
                "regex": "^\\.\\./[^/]+/[^/]+\\.routes(\\.ts)?$",
                "message": "Routers meet in app.ts. Call the other feature's service."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/api/src/features/**/*.service.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["drizzle-orm", "drizzle-orm/*"],
                "message": "Services hold business rules. Build queries in the feature's repo."
              },
              {
                "regex": "\\.table(\\.ts)?$",
                "allowTypeImports": true,
                "message": "Services hold business rules. Build queries in the feature's repo."
              },
              {
                "regex": "/db/db(\\.ts)?$",
                "importNames": ["db", "pool"],
                "message": "Services query through the repo. Use transaction() to group repo calls."
              },
              {
                "regex": "\\.(routes|middleware)(\\.ts)?$",
                "message": "Services can't depend on the HTTP layer."
              },
              {
                "regex": "^\\.\\./[^/]+/[^/]+\\.(repo|routes)(\\.ts)?$",
                "message": "Call the other feature's service, never its repo or routes."
              }
            ]
          }
        ]
      }
    },
    {
      // Chores and shopping write through householdWrites, which holds the household for the
      // write and announces it on commit. Same rules as other services, plus no way around it.
      // An override replaces the rule's options rather than adding to them, hence the repeats.
      "files": [
        "apps/api/src/features/chores/chores.service.ts",
        "apps/api/src/features/shopping/shopping.service.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["drizzle-orm", "drizzle-orm/*"],
                "message": "Services hold business rules. Build queries in the feature's repo."
              },
              {
                "regex": "\\.table(\\.ts)?$",
                "allowTypeImports": true,
                "message": "Services hold business rules. Build queries in the feature's repo."
              },
              {
                "regex": "/db/db(\\.ts)?$",
                "importNames": ["db", "pool", "transaction"],
                "message": "Write through householdWrites, which opens the transaction for you."
              },
              {
                "regex": "/live/live-changes(\\.ts)?$",
                "message": "Call scope.changed() inside householdWrites; it announces on commit."
              },
              {
                "regex": "\\.(routes|middleware)(\\.ts)?$",
                "message": "Services can't depend on the HTTP layer."
              },
              {
                "regex": "^\\.\\./[^/]+/[^/]+\\.(repo|routes)(\\.ts)?$",
                "message": "Call the other feature's service, never its repo or routes."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/api/src/features/**/*.repo.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "\\.(service|routes|middleware)(\\.ts)?$",
                "message": "The repo is the bottom layer. It can't call services or routes."
              }
            ]
          }
        ]
      }
    },
    {
      // Tables and contracts can import Drizzle and table definitions (foreign keys, select schemas),
      // never runtime DB access, repos, services or routes.
      "files": ["apps/api/src/features/**/*.table.ts", "apps/api/src/features/**/*.schema.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(\\.(service|routes|middleware|repo)|/db/db)(\\.ts)?$",
                "message": "Tables and schemas define shapes only; they can't import db, repos, services or routes."
              }
            ]
          }
        ]
      }
    },
    {
      // Feature-owned infrastructure that wires up Better Auth and Postgres LISTEN/NOTIFY
      "files": ["apps/api/src/features/auth/auth.ts", "apps/api/src/features/live/live-changes.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "\\.(service|routes|middleware|repo)(\\.ts)?$",
                "message": "Feature infrastructure can't import routes, services or repos."
              }
            ]
          }
        ]
      }
    },
    {
      // Integration tests compose the app, tables and database helpers directly
      "files": ["apps/api/src/features/**/*.test.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["apps/api/src/lib/**", "apps/api/src/env.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              { "regex": "/features/", "message": "Shared code can't depend on a feature." }
            ]
          }
        ]
      }
    },

    // Rules the web app bundles from the API (exports in apps/api/package.json) import types only,
    // so no server code reaches the browser. Placed after API feature overrides so it always wins.
    {
      "files": [
        "apps/api/src/features/chores/chore-schedule.ts",
        "apps/api/src/features/households/invite-code.ts",
        "apps/api/src/features/live/live-topics.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": ".*",
                "allowTypeImports": true,
                "message": "The web app bundles this file (see exports in apps/api/package.json). Import types only, so no server code reaches the browser."
              }
            ]
          }
        ]
      }
    },

    {
      "files": ["apps/web/**"],
      "plugins": ["react", "jsx-a11y"],
      "env": {
        "browser": true
      },
      "rules": {
        // Side-effect imports: stylesheets, and polyfills that install themselves
        "import/no-unassigned-import": [
          "warn",
          { "allow": ["**/*.css", "temporal-polyfill/global"] }
        ],
        "react/react-in-jsx-scope": "off",
        "react/rules-of-hooks": "error",
        "react/only-export-components": ["warn", { "allowConstantExport": true }]
      }
    },
    {
      // Static grocery word dictionary, not logic
      "files": ["apps/web/src/features/shopping/grocery-words.ts"],
      "rules": {
        "max-lines": "off"
      }
    },

    // Icons come from one module, so the icon library can be swapped in one file.
    // Repeated in the layering overrides below, because a later override replaces the rule's options.
    {
      "files": ["apps/web/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@phosphor-icons/",
                "message": "Import icons from @/components/icons.ts, so the icon library can be swapped in one file."
              },
              {
                "regex": "^sonner$",
                "message": "Show toasts through @/lib/feedback.ts, which keeps them one at a time and on the rules in DESIGN.md."
              }
            ]
          }
        ]
      }
    },

    // Web layering: routes -> features -> shared (components, lib). Features never import each other,
    // and write through changes (lib/offline-changes.ts) rather than their own mutations.
    {
      "files": ["apps/web/src/components/**", "apps/web/src/lib/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/**", "@/routes/**", "@/router.tsx", "@/main.tsx"],
                "message": "Shared code can't depend on features or routes."
              },
              {
                "regex": "^@phosphor-icons/",
                "message": "Import icons from @/components/icons.ts, so the icon library can be swapped in one file."
              },
              {
                "regex": "^sonner$",
                "message": "Show toasts through @/lib/feedback.ts, which keeps them one at a time and on the rules in DESIGN.md."
              }
            ]
          }
        ]
      }
    },
    {
      // Files at a feature's root, e.g. features/households/households.api.ts
      "files": ["apps/web/src/features/*/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@tanstack/react-query",
                "importNames": ["useMutation", "mutationOptions"],
                "message": "Declare a change with defineChange (lib/offline-changes.ts), so it shows straight away, waits for a connection and survives a restart."
              }
            ],
            "patterns": [
              {
                "group": ["@/routes/**", "@/router.tsx", "@/main.tsx"],
                "message": "Features can't import routes or the router. Read route data with getRouteApi(), and the query client with useQueryClient()."
              },
              {
                "group": ["@/features/**"],
                "message": "Features don't import each other. Compose features in a route instead."
              },
              {
                "regex": "^\\.\\./",
                "message": "Relative imports stay inside the feature. Use @/components or @/lib for shared code."
              },
              {
                "regex": "^@phosphor-icons/",
                "message": "Import icons from @/components/icons.ts, so the icon library can be swapped in one file."
              },
              {
                "regex": "^sonner$",
                "message": "Show toasts through @/lib/feedback.ts, which keeps them one at a time and on the rules in DESIGN.md."
              }
            ]
          }
        ]
      }
    },
    {
      // Components have one place, so nobody has to decide or guess. Any import trips this.
      "files": ["apps/web/src/features/*/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": ".*",
                "message": "Components go in the feature's components/ folder. Only .ts files sit at a feature's root."
              }
            ]
          }
        ]
      }
    },
    {
      // Only .tsx components inside components/ are allowed below a feature's root.
      // The components/*.tsx overrides below replace this for valid component files.
      "files": ["apps/web/src/features/*/*/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": ".*",
                "message": "Keep features flat: .ts files at the feature's root, .tsx components directly in components/. Or split the feature."
              }
            ]
          }
        ]
      }
    },
    {
      // Components in any feature's components/ folder: run changes through *.hooks.ts
      "files": ["apps/web/src/features/*/components/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@tanstack/react-query",
                "importNames": ["useMutation", "mutationOptions"],
                "message": "Declare a change with defineChange (lib/offline-changes.ts), so it shows straight away, waits for a connection and survives a restart."
              },
              {
                "name": "@/lib/offline-changes.ts",
                "importNames": ["useChange", "useWaitingVars"],
                "message": "Run changes through the feature's hooks (*.hooks.ts) instead of calling useChange or useWaitingVars in a component."
              }
            ],
            "patterns": [
              {
                "group": ["@/routes/**", "@/router.tsx", "@/main.tsx"],
                "message": "Features can't import routes or the router. Read route data with getRouteApi(), and the query client with useQueryClient()."
              },
              {
                "group": ["@/features/**"],
                "message": "Features don't import each other. Compose features in a route instead."
              },
              {
                "regex": "^\\.\\./\\.\\./",
                "message": "Relative imports stay inside the feature. Use @/components or @/lib for shared code."
              },
              {
                "regex": "^@phosphor-icons/",
                "message": "Import icons from @/components/icons.ts, so the icon library can be swapped in one file."
              },
              {
                "regex": "^sonner$",
                "message": "Show toasts through @/lib/feedback.ts, which keeps them one at a time and on the rules in DESIGN.md."
              },
              {
                "regex": "^\\.\\./[a-z-]+\\.changes(\\.ts)?$",
                "allowTypeImports": true,
                "message": "Run changes through the feature's hooks (*.hooks.ts) instead of importing *.changes.ts in a component."
              }
            ]
          }
        ]
      }
    },
    {
      // Components of the areas whose writes are changes (AREAS in lib/offline-changes.ts). The
      // same rules as the block above (an override replaces it), plus: no API calls, types only,
      // so every write goes through a change in the feature's *.changes.ts
      "files": [
        "apps/web/src/features/shopping/components/*.tsx",
        "apps/web/src/features/chores/components/*.tsx",
        "apps/web/src/features/todos/components/*.tsx"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@tanstack/react-query",
                "importNames": ["useMutation", "mutationOptions"],
                "message": "Declare a change with defineChange (lib/offline-changes.ts), so it shows straight away, waits for a connection and survives a restart."
              },
              {
                "name": "@/lib/offline-changes.ts",
                "importNames": ["useChange", "useWaitingVars"],
                "message": "Run changes through the feature's hooks (*.hooks.ts) instead of calling useChange or useWaitingVars in a component."
              }
            ],
            "patterns": [
              {
                "group": ["@/routes/**", "@/router.tsx", "@/main.tsx"],
                "message": "Features can't import routes or the router. Read route data with getRouteApi(), and the query client with useQueryClient()."
              },
              {
                "group": ["@/features/**"],
                "message": "Features don't import each other. Compose features in a route instead."
              },
              {
                "regex": "^\\.\\./\\.\\./",
                "message": "Relative imports stay inside the feature. Use @/components or @/lib for shared code."
              },
              {
                "regex": "^@phosphor-icons/",
                "message": "Import icons from @/components/icons.ts, so the icon library can be swapped in one file."
              },
              {
                "regex": "^sonner$",
                "message": "Show toasts through @/lib/feedback.ts, which keeps them one at a time and on the rules in DESIGN.md."
              },
              {
                "regex": "^\\.\\./[a-z-]+\\.changes(\\.ts)?$",
                "allowTypeImports": true,
                "message": "Run changes through the feature's hooks (*.hooks.ts) instead of importing *.changes.ts in a component."
              },
              {
                "regex": "^\\.\\./[a-z-]+\\.api(\\.ts)?$",
                "allowTypeImports": true,
                "message": "Write through the feature's hooks, which run its changes (*.changes.ts), so a write shows straight away, waits for a connection and survives a restart. Read through its queries."
              }
            ]
          }
        ]
      }
    },
    {
      // Keep features flat: never nest folders inside components/ either
      "files": ["apps/web/src/features/*/*/*/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": ".*",
                "message": "Keep features flat: .ts files at the feature's root, .tsx components directly in components/. Or split the feature."
              }
            ]
          }
        ]
      }
    },
    {
      // The one module that shows toasts (ui/sonner.tsx, the Toaster, is allowed with the shadcn files below)
      "files": ["apps/web/src/lib/feedback.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/**", "@/routes/**", "@/router.tsx", "@/main.tsx"],
                "message": "Shared code can't depend on features or routes."
              },
              {
                "regex": "^@phosphor-icons/",
                "message": "Import icons from @/components/icons.ts, so the icon library can be swapped in one file."
              }
            ]
          }
        ]
      }
    },
    {
      // TanStack route files export `Route`, shadcn components export variants
      "files": ["apps/web/src/routes/**", "apps/web/**/components/ui/**"],
      "plugins": ["react"],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      // shadcn components import icons directly (kept as shipped), and icons.ts is the one place that may
      "files": ["apps/web/src/components/ui/**", "apps/web/src/components/icons.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/**", "@/routes/**", "@/router.tsx", "@/main.tsx"],
                "message": "Shared code can't depend on features or routes."
              }
            ]
          }
        ]
      }
    },
    {
      // Generated by the shadcn CLI; keep them as shipped so updates stay diffable
      "files": ["apps/web/**/components/ui/**"],
      "plugins": ["jsx-a11y"],
      "rules": {
        "max-lines": "off",
        "jsx-a11y/prefer-tag-over-role": "off",
        "jsx-a11y/label-has-associated-control": "off"
      }
    }
  ]
}
